# Maintainer: Josh Archer
#
# AUR package for the linux-quest host daemon.
# Update pkgver and sha256sums for each tagged release (run `updpkgsums` or
# `makepkg -g`). sha256sums=('SKIP') is a placeholder until the tag exists.

pkgname=linux-quest-host
pkgver=0.1.0
pkgrel=1
pkgdesc='Linux Quest 3 VR streaming host and virtual display daemon'
arch=('x86_64')
url='https://github.com/Josh-Archer/linux-quest'
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'cmake')
optdepends=(
  'wl-clipboard: clipboard sync on Wayland'
  'xclip: clipboard sync on X11'
  'wtype: committed Unicode text injection on Wayland'
  'xdotool: committed Unicode text injection on X11'
  'pipewire: screen and audio capture'
  'nvidia-utils: NVIDIA GPU encoding'
)
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "linux-quest-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "linux-quest-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p linux-quest-host --features mdns
}

check() {
  cd "linux-quest-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # Unit tests only: the integration tests depend on host state (display, uinput,
  # network) and are not reliable in a clean chroot.
  cargo test --frozen -p linux-quest-host --lib
}

package() {
  cd "linux-quest-${pkgver}"
  install -Dm755 "target/release/linux-quest-host" "${pkgdir}/usr/bin/linux-quest-host"
  install -Dm644 "packaging/udev/99-uinput.rules" "${pkgdir}/usr/lib/udev/rules.d/99-uinput.rules"
  install -Dm644 "packaging/modules-load/linux-quest.conf" "${pkgdir}/usr/lib/modules-load.d/linux-quest.conf"
  install -Dm644 "packaging/systemd/linux-quest-host.service" "${pkgdir}/usr/lib/systemd/user/linux-quest-host.service"
  install -Dm644 "LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
